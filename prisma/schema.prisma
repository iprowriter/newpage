// Data model — specs.md §4.
//
// Postgres is the system of record for everything except vectors. Qdrant holds
// one point per chunk: the embedding plus a minimal payload for filtering
// (ADR-0010). Chunk *text* lives here rather than in Qdrant so a citation can be
// rendered and highlighted without a vector round-trip.
//
// Prisma 7: no `url` in the datasource — the CLI reads it from prisma.config.ts,
// the runtime client from a driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CollectionKind {
  /// A department. Curated, named, shared.
  collection
  /// A throwaway space for one or two documents someone does not want to file
  /// yet. Promotable into a collection.
  chat
}

/// The retrieval scope (ADR-0002) and the isolation boundary.
///
/// Under ADR-0010 that boundary is a payload filter rather than a physical
/// partition, so it is enforced in code — see the single retrieval entry point
/// in src/lib/rag (specs.md §7.3).
///
/// **A chat is a collection with a different `kind`, not a second entity.** The
/// alternative — chats as their own model — would mean two things a document can
/// belong to, two filters, and two shapes for the isolation invariant to hold in.
/// One model means promoting a chat is a reassignment rather than a migration
/// between two worlds, and every guarantee proved for collections holds for chats
/// for free.
model Collection {
  id          String         @id @default(cuid())
  /// Not unique: chats are created unnamed and in bulk, and "New chat" colliding
  /// with an earlier "New chat" is not an error worth raising at anyone.
  name        String
  kind        CollectionKind @default(collection)
  description String?

  /// Per-collection retrieval config: a contract and an RFC do not want the same
  /// chunking (ADR-0002). Defaults come from the app; overrides live here.
  chunkTokens Int @default(350)
  topK        Int @default(6)

  /// Superseded by chats: the seeded "Quick start" collection existed so there
  /// was somewhere to drop a one-off document, which is now what a chat is for.
  /// Retained only so the landing route has something to prefer.
  isDefault Boolean @default(false)

  /// An orientation blurb for someone opening a collection they did not build.
  /// Generated on demand rather than at ingest, because it describes the whole
  /// set and every new document changes the answer.
  summary String?

  /// Hash of the member document ids. Compared before serving the cached summary —
  /// a count alone would miss a swap (one document out, one in), and silently
  /// describing a collection that no longer exists is worse than regenerating.
  summaryFingerprint String?

  documents Document[]
  chunks    Chunk[]
  traces    QueryTrace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DocumentStatus {
  pending
  processing
  ready
  failed
  /// Qdrant points were removed but the Postgres rows were not (specs.md §10).
  /// Orphaned rows are invisible to retrieval and cleanable; the reverse would
  /// leave live vectors citing a deleted document.
  delete_failed
}

model Document {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  filename  String
  mimeType  String
  byteSize  Int
  pageCount Int?

  status DocumentStatus @default(pending)
  /// Populated on `failed`. A scanned PDF extracting zero text is a hard failure
  /// with a message, never a silent empty ingest (ADR-0018).
  error  String?

  /// Three starter questions, generated at ingest from this document's own
  /// heading tree and stored (ADR-0019). Generated once because they do not
  /// change, and a per-page-load LLM call is a visible stall on the Ollama path.
  /// Ingest succeeds even if this step fails — degrade to no suggestions.
  starterQuestions String[] @default([])

  chunks Chunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collectionId, status])
}

/// One retrievable unit. Structure-aware and token-bounded (ADR-0012).
model Chunk {
  /// UUID rather than cuid, and not a style preference: Qdrant point ids must be
  /// an unsigned integer or a UUID, and it rejects anything else outright. Using
  /// the same id in both stores keeps the mapping 1:1 — no lookup table, and a
  /// Qdrant hit is directly a Postgres primary key.
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Denormalised from Document so isolation checks and delete-by-filter never
  /// need a join. It is the single most important column in the schema.
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  chunkIndex Int
  page       Int?

  /// "Doc title > Section > Subsection". Prepended to the *embedded* text to
  /// restore context a chunk loses in isolation (ADR-0012) — and deliberately
  /// NOT part of displayText. Two representations per chunk; a subtle trap, so
  /// specs.md §11 tests it.
  headingPath String[] @default([])

  /// What the user sees when they open a citation. No breadcrumb.
  displayText String

  /// Offsets into the extracted document text, captured at ingest even though
  /// the highlight viewer is Tier 2 — cheap now, expensive to backfill.
  charStart Int
  charEnd   Int

  tokenCount Int

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([collectionId])
}

enum Feedback {
  up
  down
}

enum QueryOutcome {
  answered
  /// Not an error state. A first-class path, and the headline metric for this
  /// audience (ADR-0015, ADR-0019).
  refused
  error
}

/// One row per query. The observability store is owned rather than delegated to
/// a self-hosted vendor stack (ADR-0016): three containers instead of eight, and
/// the reviewer sees traces on their own queries with no account.
model QueryTrace {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  question String
  answer   String?
  outcome  QueryOutcome

  /// Why it refused, in the user's terms — the refusal surface renders this
  /// rather than a generic "I don't know" (ADR-0019).
  refusalReason String?

  /// Graph path (ADR-0013): whether the grade rejected the first retrieval and
  /// the one permitted rewrite fired. The retry is hard-bounded; specs.md §11
  /// tests that it fires at most once.
  rewriteFired Boolean @default(false)
  rewrittenAs  String?
  gradeScore   Float?

  /// Retrieved chunk ids with scores, in rank order, for each attempt.
  retrieved Json

  /// Pinned, never a floating alias (ADR-0014). Stored per trace so any number
  /// in the README traces back to the exact setup that produced it.
  provider       String
  model          String
  embeddingModel String

  /// Human judgement on this answer.
  ///
  /// Not a satisfaction score. Retrieval scores and groundedness checks measure
  /// whether an answer was *supported*; only a reader knows whether it was
  /// *useful*, and the gap between those two is where prompt drift hides. Every
  /// rating is a labelled example, so this table becomes the seed of an eval set
  /// drawn from questions people actually asked rather than ones I invented
  /// (ADR-0015).
  feedback     Feedback?
  feedbackNote String?
  feedbackAt   DateTime?

  latencyMs    Int
  retrievalMs  Int?
  generationMs Int?
  promptTokens Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  @@index([collectionId, createdAt])
  /// The eval-set query: every rated answer, worst first.
  @@index([feedback, createdAt])
}

/// Eval harness output (ADR-0015). Persisted so "350 vs 800 tokens" and
/// "hosted vs local" are queries against real rows, not remembered numbers.
model EvalRun {
  id    String @id @default(cuid())
  label String

  provider       String
  model          String
  embeddingModel String
  chunkTokens    Int
  topK           Int
  hybrid         Boolean @default(false)

  /// Retrieval and generation are never blended into one score: a single number
  /// says something is wrong without saying where (ADR-0015).
  recallAtK        Float?
  mrr              Float?
  groundedness     Float?
  citationAccuracy Float?
  /// The headline number for this audience: of the questions the corpus cannot
  /// answer, how many were correctly refused.
  refusalRate      Float?

  results EvalResult[]

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

enum EvalKind {
  /// Answerable from the collection under test.
  answerable
  /// Answerable, but only in a *different* collection. Tests isolation and
  /// refusal in one shot (ADR-0017).
  out_of_collection
  /// Plausible, in-domain, absent from the corpus.
  out_of_corpus
  /// "What does Section 12 say about X" when there is no Section 12.
  false_premise
  /// Answerable-shaped, but the figure is never stated.
  unstated
  /// Wrong domain entirely. A floor.
  off_domain
}

model EvalResult {
  id    String  @id @default(cuid())
  runId String
  run   EvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  question       String
  kind           EvalKind
  collectionName String

  /// Labelled by hand from the source documents *before* looking at chunk
  /// boundaries — questions written from one's own chunks flatter one's own
  /// retrieval (ADR-0015). Empty for every negative kind.
  expectedChunkIds String[] @default([])

  retrievedChunkIds String[] @default([])
  rank              Int?
  refused           Boolean
  /// For negative kinds, refusing IS passing.
  passed            Boolean
  answer            String?
  judgeScore        Float?
  judgeNotes        String?

  latencyMs Int?

  @@index([runId, kind])
}
