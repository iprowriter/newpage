# Copy to .env.local and fill in. Never commit a real key (ADR-0009).
#
# `.env.local` is read by both `npm run dev` and `docker compose` (via env_file),
# so there is one file, not two. Compose overrides the addresses below with
# container-network ones; everything else comes from here.

# --- Provider -----------------------------------------------------------------
# gemini (default, fast) | ollama (local, private, slower — no GPU in Docker on macOS)
LLM_PROVIDER=gemini

# Gemini has a free tier: https://aistudio.google.com/apikey — your own key, two minutes.
GEMINI_API_KEY=

# Pinned model ids. Never a floating alias: eval numbers must be reproducible (ADR-0014).
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_MODEL=llama3.2:3b

# Embeddings always run locally (ADR-0004). Changing this means dropping and
# reindexing — its dimension is fixed into the Qdrant collection at creation.
EMBEDDING_MODEL=nomic-embed-text

# Two Ollama endpoints, because the two workloads want different homes.
#   OLLAMA_BASE_URL   generation — the host, where the GPU is (ADR-0003)
#   EMBEDDING_BASE_URL embeddings — CPU-fast, so Compose points this at a
#                     container and `docker compose up` can ingest with no host
#                     setup at all (ADR-0004)
# Left unset, embeddings fall back to the generation endpoint — fine only if you
# have Ollama on the host with the embedding model pulled.
#
# For `npm run dev`, prefer the line below: compose publishes the embedding
# container on 11435, so the app embeds against the container and no host Ollama
# is needed for ingestion. `docker compose up` ignores both of these and uses the
# container network directly.
OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_BASE_URL=http://localhost:11435

# --- Observability --------------------------------------------------------------
# Traces render in-app at /traces with no configuration. OpenTelemetry spans are
# emitted alongside them and dropped unless an endpoint is set, so pointing this
# at Langfuse, Datadog, Honeycomb or a local collector is the whole integration.
# `docker compose up` wires these to the bundled Jaeger automatically. Set them
# here only when running `npm run dev` on the host against the same viewer.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=newpage-docs-assistant
# NEXT_PUBLIC_TRACE_UI_URL=http://localhost:16686

# --- Data ---------------------------------------------------------------------
# Host ports default high (55432 / 56333) so `docker compose up` cannot collide
# with a Postgres or Qdrant you already run. Override POSTGRES_PORT / QDRANT_PORT
# if you want them somewhere else.
DATABASE_URL=postgresql://newpage:newpage@localhost:55432/newpage
QDRANT_URL=http://localhost:56333

# Next.js phones home during `next dev` and `next build`. Harmless, but it shows
# up as a `fetch POST telemetry.nextjs.org` span in Jaeger alongside this app's
# own traces, which is noise in a screenshot. The Docker images already set this;
# this line covers `npm run dev` on the host.
NEXT_TELEMETRY_DISABLED=1
